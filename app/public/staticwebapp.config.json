{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "routes": [
    {
      "route": "/legal/privacy-policy.md",
      "redirect": "/privacy",
      "statusCode": 301
    },
    {
      "route": "/legal/terms-of-service.md",
      "redirect": "/terms",
      "statusCode": 301
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/assets/*",
      "/legal/*",
      "*.{css,js,mjs,svg,png,gif,jpg,jpeg,webp,ico,woff,woff2,ttf,otf,map,json,txt,xml,md}"
    ]
  },
  "mimeTypes": {
    ".json": "application/json",
    ".md": "text/markdown; charset=utf-8"
  },
  "globalHeaders": {
    "Cache-Control": "no-cache, must-revalidate"
  },
  "responseOverrides": {
    "404": { "rewrite": "/index.html", "statusCode": 200 }
  }
}
