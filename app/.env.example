# Local dev env template. Copy to `.env` and fill in. `.env` is gitignored.
# `.env.production` is loaded by `vite build` and is also gitignored — keep
# real prod values there, not here.

VITE_API_BASE_URL=http://localhost:4000/api/v1

# Demo auto-login — signs in with the seeded account on first load.
# Use only for local development / internal demos. Both EMAIL and PASSWORD
# must be set for the auto-login path to engage; empty strings (default in
# prod builds) skip it. AuthContext also short-circuits on
# `import.meta.env.PROD`, so a prod bundle never honours these regardless.
VITE_ENABLE_DEMO_AUTO_LOGIN=false
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=

# Google Sign-In OAuth Web Client ID (Cloud Console > Credentials).
# When unset, the Google button is hidden (email/password login still works).
VITE_GOOGLE_CLIENT_ID=

# Sentry DSN — when unset, the SDK is a no-op.
VITE_SENTRY_DSN=
