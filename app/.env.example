VITE_API_BASE_URL=/api/v1

# Demo auto-login — signs in with the seeded account on first load.
# Use only for development / internal demos. Production builds must set this to false (or unset).
VITE_ENABLE_DEMO_AUTO_LOGIN=true

# Demo seed account (must match backend prisma/seed.ts)
VITE_DEMO_EMAIL=polopot123@gmail.com
VITE_DEMO_PASSWORD=password1234

# Google Sign-In OAuth Web Client ID (Cloud Console > Credentials).
# When unset, the Google button is hidden (email/password login still works).
VITE_GOOGLE_CLIENT_ID=

# Sentry DSN — when unset, the SDK is a no-op.
VITE_SENTRY_DSN=
