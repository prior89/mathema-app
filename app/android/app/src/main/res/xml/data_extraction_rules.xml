<?xml version="1.0" encoding="utf-8"?>
<!--
  Matheo stores an authenticated student session and learning data inside the
  Capacitor WebView.  Do not copy that state through Android cloud backup or
  device-to-device transfer; the student must authenticate on the new device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
