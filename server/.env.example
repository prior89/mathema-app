# ===== App =====
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

# ===== PostgreSQL =====
DATABASE_URL=postgresql://mathema:mathema@localhost:5432/mathema?schema=public

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== JWT =====
# In production (NODE_ENV=production) the app refuses to boot with placeholder/weak secrets.
# Generate a new secret:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# access != refresh.  Minimum 32 characters.
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ===== Admin =====
# Comma-separated list of emails permitted to access admin pages.
ADMIN_EMAILS=VeraStudy01@gmail.com,polopot123@gmail.com
# Extra emails to exclude from learning-effectiveness KPI aggregates (optional).
# Built-in exclusions already cover admin@mathema.app, polopot*, and e2e-*@example.com.
METRICS_EXCLUDE_EMAILS=

# ===== Feature flags (0–100 rollout percent per flag) =====
FEATURE_ADAPTIVE_DIAGNOSTIC_PCT=0
FEATURE_FIRST_SESSION_ACHIEVEMENT_PCT=0
FEATURE_KR_COLD_START_PCT=0
FEATURE_STUDENT_EFFICACY_CARD_PCT=0

# ===== Mail (optional) =====
# In production SMTP_HOST must be set, otherwise resend/verification email
# returns a clear error instead of pretending delivery succeeded.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@matheo.ai

# ===== Google Sign-In (optional) =====
GOOGLE_CLIENT_ID=

# ===== Billing UI switch (default off — v1.0 free PoC) =====
# Set to true to expose paywall / upgrade CTAs without a frontend rebuild.
BILLING_UI_ENABLED=false

# ===== Sentry (optional) =====
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ===== Firebase / FCM (optional, push — NOT the same as Google login OAuth) =====
# Server push: Firebase Console → Project settings → Service accounts → Generate new private key.
# Android app: download google-services.json → app/android/app/google-services.json (gitignored).
# See app/android/app/google-services.json.example for package ai.matheo.app.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ===== AI providers (fill in your keys) =====
# All LLM / vision / embedding calls go through src/infrastructure/ai/providers/*.
AI_LLM_PROVIDER=anthropic            # anthropic | openai
AI_LLM_API_KEY=
AI_LLM_MODEL=claude-opus-4-7

AI_VISION_PROVIDER=openai            # openai | google
AI_VISION_API_KEY=
AI_VISION_MODEL=gpt-4o

AI_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=text-embedding-3-large

# ===== Math helper microservice =====
# Started by root `npm run dev`, or manually with `npm run dev:math-helper`.
MATH_HELPER_URL=http://127.0.0.1:8000
MATH_HELPER_TIMEOUT_MS=120000

# ===== Math OCR (Mathpix) =====
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
MATHPIX_TIMEOUT_MS=180000

# ===== Storage =====
STORAGE_DRIVER=local                 # local | s3
STORAGE_LOCAL_DIR=./uploads
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
