// =============================================================
//  Mathēma — Single Source of Truth
//  Unified naming for subject (User) / objects (Problem, WrongNote, Attempt, ...)
// =============================================================

generator client {
  provider      = "prisma-client-js"
  // `native` for local dev (macOS/Windows/Linux glibc); the musl + openssl-3
  // target is the one needed inside the node:20-alpine Docker image — without
  // it Prisma's schema engine crashes with
  //   "Could not parse schema engine response: SyntaxError: Unexpected token 'E', 'Error load'..."
  // because the prebuilt engine binary cannot find libssl-1.1.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- ENUMS (1:1 with src/common/enums/*) ----------

enum Difficulty {
  MIDDLE // medium
  UPPER_MIDDLE // upper-medium
  SEMI_KILLER // semi-killer
  KILLER // killer
}

enum ErrorType {
  CONCEPT_MISUNDERSTANDING // conceptual misunderstanding
  CALCULATION_MISTAKE // calculation mistake
  TIME_SHORTAGE // ran out of time
  OTHER // other
}

enum NoteStatus {
  PENDING
  ANALYZING
  MASTERED
}

enum SessionContext {
  STUDY
  EXAM
  PRACTICE
  DIAGNOSTIC
}

enum MockExamType {
  HAKPYEONG // Korean academic-ability test (hakpyeong)
  MOPYEONG // Korean mock CSAT (mopyeong)
  SUNEUNG // Korean CSAT (suneung)
  RECOMMENDED // AI-personalized diagnostic
  MINI // per-unit mini exam
  WRONG_REDO // re-test of previous wrong answers
  REAL // full-scale realistic mock exam
}

/// Step kinds of the 3-stage multiple-choice solving flow
enum StepType {
  CONCEPT // Stage 1: which concept to apply
  PROCESS // Stage 2: the solving process
  ANSWER // Stage 3: final answer
}

/// Analytical classification of attractive distractors — tracks student thinking patterns via data
enum DistractorType {
  CONCEPT_CONFUSION // confusion with another concept (e.g., disk vs. shell)
  CALC_ERROR // calculation-step mistake (sign, exponent, substitution)
  PROCESS_SKIP // missing a solving step (forgot to square, multiply by π, convert intervals)
  TIME_PRESSURE_GUESS // common misclick under time pressure (mixed up with another problem's answer)
}

/// Grade selected at signup. For unit mapping see Unit.gradeLevels.
/// Indian NCERT class system — Class 7 through Class 12.
enum GradeLevel {
  CLASS_7
  CLASS_8
  CLASS_9
  CLASS_10
  CLASS_11
  CLASS_12
}

/// NCERT class — classification dimension for ConceptLesson.
/// Separate from GradeLevel: the NCERT chapter tree uses the Indian class system as primary reference.
enum NcertClass {
  CLASS_7
  CLASS_8
  CLASS_9
  CLASS_10
  CLASS_11
  CLASS_12
}

/// Korean school grade — primary classification axis for KoreanConceptLesson.
/// Matches the 2022 개정 교육과정 sequence. country=KR users see chapters
/// keyed by this grade × KoreanSubject grid; country=IN users continue to
/// see NcertClass × NCERT chapters via the parallel ConceptLesson tree.
enum KoreanGrade {
  MIDDLE_1 // 중1
  MIDDLE_2 // 중2
  MIDDLE_3 // 중3
  HIGH_1   // 고1
  HIGH_2   // 고2
  HIGH_3   // 고3
}

/// Korean math subject — secondary axis (a single Korean grade can offer
/// multiple subjects, e.g. 고2 takes 대수 + 미적분Ⅰ + 확률과 통계 등).
/// All names match the 2022 개정 교육과정 official curriculum.
enum KoreanSubject {
  MIDDLE_MATH_1   // 수학 1 (중1)
  MIDDLE_MATH_2   // 수학 2 (중2)
  MIDDLE_MATH_3   // 수학 3 (중3)
  HIGH_COMMON_1   // 공통수학1 (고1, 필수)
  HIGH_COMMON_2   // 공통수학2 (고1, 필수)
  HIGH_ALGEBRA    // 대수 (고2 일반선택, 수능 출제)
  HIGH_CALCULUS_1 // 미적분Ⅰ (고2 일반선택, 수능 출제)
  HIGH_CALCULUS_2 // 미적분Ⅱ (진로선택)
  HIGH_STATISTICS // 확률과 통계 (일반선택, 수능 출제)
  HIGH_GEOMETRY   // 기하 (진로선택)
}

/// Step kinds within a single concept-lesson session — translates the 6 cognitive-psychology principles into stages.
///   HOOK            activate interest / prior knowledge (Ausubel advance organizer)
///   CONCRETE        concrete objects / manipulation (Bruner CPA — Concrete)
///   PICTORIAL       visual representation (Bruner CPA — Pictorial, Dual Coding)
///   ABSTRACT        symbols / definitions (Bruner CPA — Abstract, Variation Theory)
///   WORKED_EXAMPLE  demonstration of solving process (Sweller worked-example effect, CLT)
///   GUIDED_PRACTICE scaffolded practice (Fading guidance)
///   RETRIEVAL       recall testing (Karpicke testing effect)
///   MISCONCEPTION   exposing and correcting common misconceptions (Conceptual change)
///   REFLECT         metacognitive summary (self-explanation)
enum ConceptStepKind {
  HOOK
  CONCRETE
  PICTORIAL
  ABSTRACT
  WORKED_EXAMPLE
  GUIDED_PRACTICE
  RETRIEVAL
  MISCONCEPTION
  REFLECT
}

/// DPDP (India Digital Personal Data Protection Act 2023) + GDPR consent kinds.
///   DATA_PROCESSING  required — auto-granted at signup; revocation deactivates the account
///   ANALYTICS        optional — learning-pattern / wrong-answer analysis (service improvement)
///   MARKETING        optional — email / push notifications
///   AI_TRAINING      optional — using learning data to fine-tune AI models
enum ConsentKind {
  DATA_PROCESSING
  ANALYTICS
  MARKETING
  AI_TRAINING
}

/// School level — corresponds to the spec's Student.schoolLevel.
enum SchoolLevel {
  ELEMENTARY
  MIDDLE
  HIGH
}

/// Study goal — selected by the student on onboarding screen 05. Used to branch recommendation-engine weights.
///   BOARD   : preparation for CBSE Class 10/12 board exams
///   JEE     : entrance-exam prep such as JEE Main / JEE Advanced / NEET
///   SCHOOL  : keeping up with school progress (regular assessments)
///   CATCHUP : filling gaps from earlier grades (foundation reinforcement)
enum StudyGoal {
  BOARD
  JEE
  SCHOOL
  CATCHUP
}

/// Problem authoring style / target exam. Drives LLM-generation prompts
/// (NCERT plain text vs JEE/NEET MCQ flavour) and lets the recommender
/// match a student's StudyGoal to format-appropriate problems. NULL =
/// not yet classified; treated as NCERT_TEXTBOOK by default.
///   IN: NCERT_TEXTBOOK / CBSE_BOARD / JEE_MAIN / JEE_ADVANCED / NEET
///   KR: KSAT (수능) / KR_INTERNAL (내신) / KR_MOCK_EVAL (평가원 모의고사)
enum ExamFormat {
  NCERT_TEXTBOOK
  CBSE_BOARD
  JEE_MAIN
  JEE_ADVANCED
  NEET
  KSAT
  KR_INTERNAL
  KR_MOCK_EVAL
}

/// User role — basis for the spec §1 split UI of student / parent / teacher / admin.
enum UserRole {
  STUDENT
  PARENT
  TEACHER
  ADMIN
}

/// Error-cause codes — the spec's errorCodes. Used by both ErrorPatternProfile,
/// Attempt, and ProblemChoice.distractorErrorCode (distractor taxonomy).
///
/// Legacy 8 (top): kept as-is for backward compat with existing Attempt rows
/// and analytics dashboards. New entries (bottom) follow the 2026-05-24 user-
/// spec taxonomy + per-chapter specific codes used when authoring KR Mastery
/// 20-problem sets (정수와 유리수 ADD_NUMERATOR_ONLY, 일차함수
/// SLOPE_INTERCEPT_CONFUSION, 도형 닮음 CORRESPONDING_PART_ERROR /
/// AREA_RATIO_ERROR, etc.).
enum ErrorCode {
  // Legacy 8 — preserved verbatim. Spec-name mapping shown in comments:
  SIGN // SIGN_ERROR — sign handling (±, 부등호 방향)
  ALG // ALGEBRA_ERROR — algebraic transformation (전개, 이항, 약분)
  CON // CONCEPT_MISUNDERSTANDING — misapplied definition
  FORMULA // FORMULA_SELECTION_ERROR — formula misuse
  GRAPH // GRAPH_READING_ERROR — graph/coord/slope interpretation
  UNIT // unit conversion
  CALC // ARITHMETIC_ERROR — calculation mistake
  LOGIC // logical flow / case separation
  // Newly added 2026-05-24 (user spec 12 + per-chapter specific):
  CONDITION_MISSING // 문제 조건을 놓쳐 풀이가 어긋남
  DENOMINATOR_ERROR // 통분/분모 처리 실수
  GEOMETRY_PROPERTY_ERROR // 도형 성질 (각·변·합동 조건 등) 오해
  RATIO_SCALE_ERROR // 비례·닮음비·단위 스케일 오류
  PROBABILITY_COUNTING_ERROR // 경우의 수·확률 세기 실수
  STATISTICS_INTERPRETATION_ERROR // 평균·분산·표준편차 해석 오류
  SLOPE_INTERCEPT_CONFUSION // 기울기와 y절편을 혼동 (일차함수 단원)
  CORRESPONDING_PART_ERROR // 닮음·합동에서 대응변·대응각 짝짓기 실패
  AREA_RATIO_ERROR // 길이비를 그대로 넓이비로 적용 (제곱 누락)
  ADD_NUMERATOR_ONLY // 분모를 고려하지 않고 분자만 더함 (분수 덧셈 첫 단계 함정)
}

/// Status of a recurring-mistake pattern — expressed to the student as an "improvable state", not a fixed ability.
enum ErrorPatternStatus {
  ACTIVE // recurred 3+ times recently
  IMPROVING // frequency declining over the last 5 occurrences
  RESOLVED // not seen in the last 5+ occurrences
}

/// Validation state of LLM analysis output. Prevents rawOutput from being used directly in business logic.
enum LLMValidationStatus {
  PENDING
  VALIDATED
  REJECTED
  NEEDS_REVIEW
}

/// LLM analysis-queue job status — DB tracking state kept in sync with the BullMQ queue.
///   PENDING      : just enqueued
///   PROCESSING   : worker has started (active)
///   COMPLETED    : finished successfully and LLMAnalysisLog was created
///   FAILED       : exceeded retry limit (kept permanently in dead-letter)
///   NEEDS_REVIEW : low LLM confidence — awaiting manual review
///   RETRYING     : transient failure — retrying with backoff
enum LLMJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  NEEDS_REVIEW
  RETRYING
}

/// Recommendation kinds — RecommendationLog.recommendationType.
enum RecommendationType {
  ADAPTIVE_NEXT // one next problem (within the current solving flow)
  SIMILAR_PROBLEM // one of 5 similar problems
  REVIEW_PROBLEM // review based on SM-2 forgettingRisk
}

enum RecommendationResult {
  CORRECT
  INCORRECT
  SKIPPED
}

/// MasteryTrajectory.trend.
enum MasteryTrend {
  UP
  DOWN
  STABLE
}

/// MasteryTrajectory.updatedBy — tracks the source of the update.
enum MasteryUpdateSource {
  RULE_BASED
  LLM
  HYBRID
  TEACHER_OVERRIDE
}

/// Feedback.targetType — the 4 kinds of AI output.
enum FeedbackTargetType {
  AI_INSIGHT
  WEEKLY_REPORT
  NEXT_PROBLEM
  EXPLANATION
}

/// Feedback.raterType — who is rating. The same 1~5 score means different things by rater.
enum FeedbackRaterType {
  STUDENT
  TEACHER
  PARENT
  ADMIN
}

/// TeacherOverride.targetType — the kind of AI judgment the teacher is overriding.
enum TeacherOverrideTargetType {
  MASTERY
  ERROR_PATTERN
  RECOMMENDATION
}

/// User country — basis for curriculum / locale / currency mapping.
/// First launch: IN (India). KR, US, UK, AU, etc. will be added subsequently.
enum CountryCode {
  IN // India (NCERT/CBSE) — 1st launch
  KR // Korea (CSAT)
  US // United States (Common Core / SAT)
  UK // United Kingdom (GCSE)
  AU // Australia (ACARA)
  SG // Singapore (MOE)
  AE // United Arab Emirates (CBSE/NCERT-aligned schools) — active market
  ID // Indonesia (Merdeka) — planned, content gap (PSE/Bahasa)
  GLOBAL // unspecified / other
}

// ---------- USER ----------

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  name         String // e.g., Arjun
  examDate     DateTime // exam date → D-day calculation
  targetGrade  Int // target grade (1~9)
  /// Grade selected at signup — used to recommend / filter units. Nullable for backward compatibility with existing users.
  gradeLevel   GradeLevel?  @default(CLASS_12)
  /// User country — determines curriculum / currency / date format. Defaults to GLOBAL when unspecified.
  country      CountryCode  @default(IN)
  /// School level — corresponds to the spec's Student.schoolLevel. Derivable from gradeLevel, but storing it explicitly simplifies analytics.
  schoolLevel  SchoolLevel?
  /// Study goal — onboarding screen 05. NULL = unspecified (legacy users).
  studyGoal    StudyGoal?
  /// Role — basis for the spec §1 split UI of student / parent / teacher / admin. Defaults to STUDENT.
  role         UserRole     @default(STUDENT)
  /// Parent-child mapping (Parent → Student.id). Used only when role is PARENT.
  /// (Future phase: when a parent manages multiple children, split into a dedicated ParentChildLink model)
  childOfUserId String?
  /// Academy / institution (multi-tenant). null = solo student.
  tenantId     String?
  /// Soft delete — null means active user. If set, authentication is blocked but analytics assets are preserved.
  deletedAt    DateTime?
  /// P2-1 — set when /auth/verify-email consumes the user's token. NULL = the
  /// user has never confirmed they own the email on file. Frontend can show a
  /// "verify your email" banner; future policy may gate certain features.
  emailVerifiedAt DateTime?
  /// Stable Google OpenID subject. Email is mutable/reassignable for some
  /// non-Gmail accounts, so Google sign-in resolves by this identifier after
  /// the first secure link instead of repeatedly joining on email.
  googleSubject String? @unique
  /// Student birth date — used for KR PIPA / IN DPDP minor & parental consent gates.
  birthDate DateTime?
  /// Set when a verifiable parent/guardian consent flow completes (see GuardianConsentRequest).
  guardianConsentVerifiedAt DateTime?
  /// MFA-1 — base32 TOTP secret. NULL = MFA never enrolled. Encrypted at rest
  /// is a v1.1 follow-up; for now the column is plain text + relies on DB-
  /// level access control. Setting this does NOT enable the challenge until
  /// totpEnabledAt is also stamped (the /auth/mfa/verify step).
  totpSecret      String?
  totpEnabledAt   DateTime?
  /// Streak + review reminder pushes (distinct from DeviceToken.marketingEnabled).
  pushRemindersEnabled Boolean @default(true)
  /// Try-first guest account — zero-PII (synthetic email, no real name/birthDate).
  /// Exempt from the guardian-consent gate; cleared on /auth/guest/upgrade.
  isGuest Boolean @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  attempts                Attempt[]
  wrongNotes              WrongNote[]
  studySessions           StudySession[]
  mockExamResults         MockExamResult[]
  activities              DailyActivity[]
  masteries               MasterySnapshot[]
  weeklyReports           WeeklyReport[]
  analyticsEvents         AnalyticsEvent[]
  deviceTokens            DeviceToken[]
  conceptProgress         ConceptProgress[]
  koreanConceptProgress   KoreanConceptProgress[]
  consents                Consent[]
  masteryTrajectories     MasteryTrajectory[]
  masteryEvents           MasteryEvent[]
  errorPatterns           ErrorPatternProfile[]
  llmAnalysisLogs         LLMAnalysisLog[]
  recommendationLogs      RecommendationLog[]
  feedbacks               Feedback[]
  teacherOverridesGiven   TeacherOverride[]     @relation("TeacherOverrider")
  teacherOverridesApplied TeacherOverride[]     @relation("StudentTarget")
  uploadedIngestJobs      ContentIngestJob[]    @relation("UploadedIngestJobs")
  reviewedDrafts          ContentDraft[]        @relation("ReviewedDrafts")
  authDevices             AuthDevice[]
  subscription            Subscription?
  placementProfile        UserPlacementProfile?
  firstSessionPlan        FirstSessionPlan?
  achievements            UserAchievement[]
  parentChildLinksAsParent ParentChildLink[] @relation("ParentChildLinksAsParent")
  parentChildLinksAsChild  ParentChildLink[] @relation("ParentChildLinksAsChild")
  guardianConsentRequest   GuardianConsentRequest?

  @@index([examDate])
  @@index([deletedAt])
  @@index([tenantId])
}

/// Adaptive placement snapshot — separate from MasteryTrajectory (KD1/KD2).
model UserPlacementProfile {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  /// Diagnostic / adaptive session that produced this profile.
  sessionId               String?
  /// GradeLevel or KoreanGrade string at placement time.
  estimatedGradeBand      String?
  /// PlacementConceptScore[] — placementScore, standardError per concept.
  conceptScores           Json     @default("[]")
  weakConceptIds          String[] @default([])
  recommendedChapterCodes String[] @default([])
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

/// Today-plan seed from placement — decoupled from recommendations runtime (PR-07).
model FirstSessionPlan {
  id          String    @id @default(uuid())
  userId      String    @unique
  /// FirstSessionCard[] — chapterCode, label, route, priority.
  cards       Json      @default("[]")
  seededAt    DateTime  @default(now())
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AchievementKind {
  FIRST_CONCEPT_STEP
  FIRST_PRACTICE_CORRECT
  FIRST_WRONGNOTE_MASTERED
}

/// First-session achievements for D0 engagement (PR-21).
model UserAchievement {
  id       String          @id @default(uuid())
  userId   String
  kind     AchievementKind
  earnedAt DateTime        @default(now())
  metadata Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([userId, earnedAt])
}

/// DPDP/GDPR consent record — append-only.
/// Repeated grant/revoke for the same (userId, kind) accumulates as separate rows for history tracking.
/// Current effective state is determined by the most recent row's revokedAt (NULL = active).
model Consent {
  id            String      @id @default(uuid())
  userId        String
  kind          ConsentKind
  /// Version of the policy consented to — used to trigger re-consent on policy updates. e.g., "2026-05-01"
  policyVersion String      @default("1.0")
  grantedAt     DateTime    @default(now())
  /// NULL = currently effective. If set, consent has been revoked.
  revokedAt     DateTime?
  /// IP / UA captured at the time of consent — for legal evidence
  ipAddress     String?
  userAgent     String?     @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, revokedAt])
  @@index([userId, grantedAt])
}

// ---------- CURRICULUM ----------

model Unit {
  id             String            @id @default(uuid())
  name           String            @unique // Calculus II
  order          Int
  /// List of grades that can study this unit (e.g., [CLASS_10, CLASS_11])
  gradeLevels    GradeLevel[]      @default([])
  subUnits       SubUnit[]
  problems       Problem[]
  studySessions  StudySession[]
  masteries      MasterySnapshot[]
  conceptLessons ConceptLesson[]
  concepts       Concept[]
}

model SubUnit {
  id     String @id @default(uuid())
  unitId String
  name   String // Applications of the Definite Integral
  order  Int

  unit           Unit            @relation(fields: [unitId], references: [id])
  problems       Problem[]
  conceptLessons ConceptLesson[]

  @@unique([unitId, name])
}

// ---------- PROBLEM ----------

model Problem {
  id         String     @id @default(uuid())
  source     String // "2024 September Mock Exam, Q30"
  unitId     String
  subUnitId  String?
  difficulty Difficulty
  body       String     @db.Text // problem body (LaTeX)
  formula    String?    @db.Text // answer formula / key solving step
  /// Core concept explanation — shown in correct/incorrect feedback and wrong-note detail
  concept    String?    @db.Text
  answer     String // final answer (kept for compatibility; fallback when steps[] is absent)
  imageUrl   String?
  hint       String?    @db.Text

  /// Solve-cache dedup (AI-solver flywheel). normalizedBody = the body with OCR
  /// noise stripped (LaTeX delimiters, whitespace, case); bodyHash =
  /// sha256(normalizedBody). On a photo solve we look up an existing Problem by
  /// bodyHash and reuse its stored solution instead of re-calling the LLM, so a
  /// growing corpus makes solves cheaper/faster/more consistent. Non-unique on
  /// purpose — re-solves and rare collisions must never raise a constraint error.
  normalizedBody String? @db.Text
  bodyHash       String?

  /// Numeric difficulty 1~5 (the spec's difficultyLevel). Separate from the Difficulty enum — used for the recommendation engine's score.
  difficultyLevel       Int         @default(3)
  /// Skills required to solve (the spec's requiredSkills). e.g., ['chain_rule', 'composite_function']
  requiredSkills        String[]    @default([])
  /// Typical solving steps (the spec's expectedSolutionSteps). Compared against stepByStepInput during LLM analysis.
  expectedSolutionSteps Json?
  /// Frequently occurring error codes (the spec's commonErrorCodes). Hint for the LLM's first-pass guess.
  commonErrorCodes      ErrorCode[] @default([])
  /// Expected solving time (seconds). Used for response-time comparison.
  expectedTimeSec       Int?

  /// Target exam / authoring style. NULL = pre-classification (legacy seed
  /// rows). Newly generated LLM problems write this from the prompt variant
  /// (e.g. JEE_MAIN when the prompt asks for JEE-style 4-option multi-choice).
  examFormat            ExamFormat?

  /// Mapped ConceptLesson — once the unit's concept learning is done, this problem becomes the 3-step MC problem.
  /// Filled by chapter-name matching in seed/migration. NULL = not mapped to concept learning (legacy).
  conceptLessonId String?
  conceptLesson   ConceptLesson? @relation(fields: [conceptLessonId], references: [id])

  /// Parallel mapping for the Korean curriculum (2022 개정). A single Problem
  /// row may map to a NCERT chapter, a Korean chapter, both, or neither.
  /// When country=KR the practice / mastery pipeline queries by this column
  /// instead of conceptLessonId. NULL = not mapped to Korean curriculum.
  koreanConceptLessonId String?
  koreanConceptLesson   KoreanConceptLesson? @relation("KoreanLessonProblems", fields: [koreanConceptLessonId], references: [id])

  /// LLM-judged quality (Tier 2 rubric grading). Active pool filters by
  /// qualityStatus IN ('APPROVED','USABLE') so EXCLUDED rows never reach
  /// students. NULL = not yet graded (treated as USABLE by default so
  /// brand-new admin entries don't get filtered before the grade pass).
  qualityScore          Float?
  qualityRubric         Json?
  qualityStatus         QualityStatus?
  qualityModel          String?
  qualityPromptVersion  String?
  qualityScoredAt       DateTime?
  qualityCriticalFlags  String[]       @default([])
  conceptMismatch       Boolean        @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  unit            Unit                @relation(fields: [unitId], references: [id])
  subUnit         SubUnit?            @relation(fields: [subUnitId], references: [id])
  attempts        Attempt[]
  wrongNotes      WrongNote[]
  steps           ProblemStep[]
  concepts        ProblemConcept[] // many-to-many with Concept
  recommendations RecommendationLog[] @relation("RecommendedProblem")

  @@index([unitId, difficulty])
  @@index([difficultyLevel])
  @@index([conceptLessonId])
  @@index([koreanConceptLessonId])
  @@index([qualityStatus])
  @@index([bodyHash])
}

/// Tier 2 LLM grading outcome for Problem rows. Drives the active-pool
/// filter in Mastery/Study endpoints.
enum QualityStatus {
  APPROVED       // finalScore >= 4.2 and no hard flag
  USABLE         // 3.5 <= finalScore < 4.2 and no hard flag
  EXCLUDED       // finalScore < 3.5 OR any hard flag (CHAPTER_MISMATCH, OUT_OF_CURRICULUM, MULTIPLE_CORRECT_OPTIONS, NO_CORRECT_OPTION, MISSING_GIVEN, LATEX_RENDERING_RISK)
}

/// 3-stage multiple-choice (CONCEPT → PROCESS → ANSWER) for a single problem
model ProblemStep {
  id        String   @id @default(uuid())
  problemId String
  stepIndex Int // 1, 2, 3
  stepType  StepType
  prompt    String   @db.Text // e.g., "What is the key concept for solving this problem?"

  problem Problem         @relation(fields: [problemId], references: [id], onDelete: Cascade)
  choices ProblemChoice[]

  @@unique([problemId, stepIndex])
  @@index([problemId])
}

/// 5 choices per step. 1 correct + 4 attractive distractors.
model ProblemChoice {
  id             String          @id @default(uuid())
  stepId         String
  choiceIndex    Int // 1~5
  text           String          @db.Text
  isCorrect      Boolean         @default(false)
  /// Distractor classification (NULL if this choice is the correct answer)
  distractorType DistractorType?
  /// Free-form distractor error code from the curriculum-specific taxonomy
  /// (e.g. SIGN_ERROR, DENOMINATOR_ERROR, GRAPH_READING_ERROR). Kept as
  /// String rather than enum so each curriculum (KR vs IN) can extend its
  /// own vocabulary without a Prisma migration. NULL on the correct option.
  distractorErrorCode String?
  /// Analyst-facing note — hypothesis on why a student might pick this distractor
  rationale      String?         @db.Text

  step       ProblemStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  selectedBy Attempt[]

  @@unique([stepId, choiceIndex])
  @@index([stepId])
}

/// Append-only log of every math-helper /solve call. Drives the
/// "AI 학습" feedback loop: each row pairs the question we asked, the
/// answer the LLM produced, and (once the student attempts it) whether
/// the student got it right. Used for weekly review of LLM accuracy,
/// few-shot example curation (high-confidence rows feed Lv 2 RAG),
/// and downstream fine-tune dataset extraction.
///
/// This table has no User FK so logging stays off the request's constraint
/// path. UsersRepository.hardDelete must delete rows by userId so question and
/// answer content does not outlive an account-deletion request.
model SolverAttempt {
  id              String    @id @default(uuid())
  userId          String?
  problemId       String?
  question        String    @db.Text
  classLevel      Int?
  llmAnswer       String?   @db.Text
  llmExplanation  String?   @db.Text
  llmSteps        Json?
  modelUsed       String?
  durationMs      Int?
  detected        Json?
  studentAnswer   String?   @db.Text
  studentCorrect  Boolean?
  fewShotCount    Int       @default(0)
  createdAt       DateTime  @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([problemId])
}

// ---------- ATTEMPT (the source of all statistics) ----------

model Attempt {
  id                  String         @id @default(uuid())
  userId              String
  problemId           String
  /// Academy / institution (multi-tenant). Same as User.tenantId (denormalized for fast per-tenant analytics).
  tenantId            String?
  context             SessionContext
  answer              String
  isCorrect           Boolean
  durationSec         Int
  /// More precise response time (milliseconds). Used alongside durationSec for fine-grained per-step analysis.
  responseTimeMs      Int?
  /// Metacognitive self-rating — confidence 0~100 just before submitting. NULL = not provided
  confidence          Int?
  /// 1~5 scale self-confidence (the spec's selfConfidenceScore). Separate from confidence (0~100).
  selfConfidenceScore Int?
  /// Whether a hint was used — a correction factor in recommendation / mastery calculations.
  hintUsed            Boolean        @default(false)
  /// Number of hints viewed (the spec's hintCount).
  hintCount           Int            @default(0)
  /// Step-by-step solution entered by the student (the spec's stepByStepInput). Key input for LLM analysis.
  stepByStepInput     Json?
  /// Error-cause codes finalized via rule-based first guess + LLM validation (the spec's errorCodes).
  errorCodes          ErrorCode[]    @default([])
  /// 'android' | 'ios' | 'web' — for per-device learning-pattern analysis.
  deviceType          String?
  /// 0~23 — for time-of-day learning-efficiency analysis. Based on user-local hour of createdAt.
  timeOfDay           Int?
  /// 3-step MC step index (1/2/3). NULL = single-answer mode (compatibility)
  stepIndex           Int?
  /// The ProblemChoice the student selected. NULL = free-form / single-answer mode
  choiceId            String?
  /// Curriculum-specific error code copied from the selected distractor at
  /// grade time (e.g. SIGN_ERROR, DENOMINATOR_ERROR). NULL when correct or
  /// when no distractor errorCode was set. Drives ErrorPatternProfile updates
  /// and adaptive recommendations for KR curriculum where the structured
  /// errorCodes enum is intentionally limited.
  distractorErrorCode String?
  studySessionId      String?
  mockExamResultId    String?
  createdAt           DateTime       @default(now())

  user            User             @relation(fields: [userId], references: [id])
  problem         Problem          @relation(fields: [problemId], references: [id])
  choice          ProblemChoice?   @relation(fields: [choiceId], references: [id])
  studySession    StudySession?    @relation(fields: [studySessionId], references: [id])
  mockExamResult  MockExamResult?  @relation(fields: [mockExamResultId], references: [id])
  llmAnalysisLogs LLMAnalysisLog[]

  @@index([userId, createdAt])
  @@index([userId, problemId])
  @@index([choiceId])
  @@index([tenantId, createdAt])
}

// ---------- WRONG NOTE ----------

model WrongNote {
  id           String     @id @default(uuid())
  userId       String
  problemId    String
  errorType    ErrorType
  insight      String     @db.Text // AI insight (summary text, kept for compatibility)
  /// Structured LLM output — schema:
  ///   { rootCause: string, correctConcept: string, drillSteps: string[],
  ///     similarPatterns: string[], confidenceCalibration: 'over'|'under'|'aligned',
  ///     reviewIntervalDays: number, lang: 'ko'|'en'|'hi' }
  insightJson  Json?
  status       NoteStatus @default(PENDING)
  similarCount Int        @default(0)
  occurrences  Int        @default(1) // cumulative occurrences of the same pattern
  masteredAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // SM-2 spaced repetition
  easinessFactor  Float     @default(2.5) // must be >= 1.3
  repetitionCount Int       @default(0) // consecutive-correct count
  intervalDays    Int       @default(0) // last assigned review interval (days)
  nextReviewAt    DateTime? // scheduled next review (NULL = not yet reviewed)
  lastReviewedAt  DateTime? // last review time
  lapseCount      Int       @default(0) // cumulative failures (quality<3)

  user    User    @relation(fields: [userId], references: [id])
  problem Problem @relation(fields: [problemId], references: [id])

  @@unique([userId, problemId])
  @@index([userId, status])
  @@index([userId, errorType])
  @@index([userId, nextReviewAt])
}

// ---------- STUDY SESSION ----------

model StudySession {
  id                     String         @id @default(uuid())
  userId                 String
  unitId                 String
  tenantId               String?
  sessionNumber          Int // 03
  totalSessions          Int // 05
  currentStep            Int            @default(1) // 1~5
  startedAt              DateTime       @default(now())
  endedAt                DateTime?
  durationSec            Int            @default(0)
  /// Session context (STUDY/EXAM/PRACTICE/DIAGNOSTIC). Used as a per-context weight in unit-balance analysis.
  context                SessionContext @default(STUDY)
  /// 'android' | 'ios' | 'web' — device dimension for per-unit study-time analysis.
  deviceType             String?
  /// 0~100. Focus indicator combining response-time stability, accuracy, hint usage, etc.
  /// The spec's focusScore. Computed as post-processing on session end.
  focusScore             Float?
  /// 'low' | 'medium' | 'high' — 'high' when response time grows and accuracy drops in the latter half of the session.
  /// The spec's fatigueSignal. Computed as post-processing on session end.
  fatigueSignal          String?
  /// Hour of day 0~23 — spec §1-1. Auto-filled from UTC hour at session start (user-local hour sent by the client takes priority).
  timeOfDay              Int?
  /// Session statistics (the spec's SessionService).
  problemCount           Int            @default(0)
  correctCount           Int            @default(0)
  averageResponseTimeSec Int?

  user     User      @relation(fields: [userId], references: [id])
  unit     Unit      @relation(fields: [unitId], references: [id])
  attempts Attempt[]

  @@index([userId, endedAt])
}

// ---------- MOCK EXAM ----------

model MockExam {
  id            String       @id @default(uuid())
  name          String // "October 2024 Academic Ability Test"
  type          MockExamType
  scheduledAt   DateTime?
  totalProblems Int          @default(30)
  totalMinutes  Int          @default(100)
  createdAt     DateTime     @default(now())

  results MockExamResult[]
}

model MockExamResult {
  id          String   @id @default(uuid())
  userId      String
  mockExamId  String
  score       Int
  grade       Int // 1~9
  percentile  Int // 0~100
  durationMin Int
  takenAt     DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id])
  mockExam MockExam  @relation(fields: [mockExamId], references: [id])
  attempts Attempt[]

  @@index([userId, takenAt])
}

// ---------- DAILY ACTIVITY (heatmap + streak) ----------

model DailyActivity {
  id             String   @id @default(uuid())
  userId         String
  date           DateTime @db.Date
  durationMin    Int      @default(0)
  problemsSolved Int      @default(0)
  accuracyPct    Float    @default(0) // 0~100
  intensity      Int      @default(0) // 0~3 (heatmap)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([userId, date])
}

// ---------- MASTERY (per-unit mastery) ----------

model MasterySnapshot {
  id             String    @id @default(uuid())
  userId         String
  unitId         String
  score          Float // 0~100
  /// Cumulative attempt count used to compute score — for confidence gating.
  samples        Int       @default(0)
  /// Cumulative study time on this unit (minutes). Integral of StudySession.durationSec. Core to unit-balance analysis.
  studyTimeMin   Int       @default(0)
  /// Distribution of the most recent N ErrorType values — { CONCEPT_MISUNDERSTANDING: 3, CALCULATION_MISTAKE: 1, ... }
  lastErrorTypes Json?
  /// Time of last attempt — used to compute the recall (decay) curve. NULL = not yet attempted.
  lastAttemptAt  DateTime?
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
  unit Unit @relation(fields: [unitId], references: [id])

  @@unique([userId, unitId])
}

// ---------- DEVICE TOKEN (FCM Push) ----------
// Mobile apps register an FCM token → used to send streak / SM-2-due notifications.

model DeviceToken {
  id         String    @id @default(uuid())
  userId     String
  token      String    @unique
  platform   String // 'android' | 'ios' | 'web'
  appVersion String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  /// Last successful send time (auto-cleanup inactive tokens when failures accumulate)
  lastSentAt DateTime?
  /// Set when the token has been invalidated (e.g., FCM NotRegistered response)
  disabledAt DateTime?
  /// Whether this device has opted into marketing pushes.
  /// Default false — only flipped true via PATCH /devices/:token/marketing when MARKETING consent is active.
  /// Learning-reminder pushes (streak / SM-2-due) ignore this flag — they are essential service notifications.
  /// Auto-reset to false when PrivacyService.revoke(MARKETING) runs.
  marketingEnabled Boolean   @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, disabledAt])
}

// ---------- ANALYTICS EVENT ----------
// User-behavior event log — all interactions besides answer submission (page view, CTA click, perspective change, modal open)
// + automatic logging of authenticated API calls. Used for funnel / retention / engagement analysis during PoC.

model AnalyticsEvent {
  id        String   @id @default(uuid())
  userId    String? // null = unauthenticated (landing, signup, etc.)
  eventType String // e.g., 'page.view' | 'cta.click' | 'api.call' | 'perspective.change'
  payload   Json // free-form meta: path/button/exam_kind/perspective/...
  sessionId String? // browser session UUID (assigned via sessionStorage)
  userAgent String?  @db.Text
  source    String? // 'frontend' | 'backend' (distinguishes auto-logged source)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@index([sessionId])
}

// ---------- AUTH TOKENS (password reset / email verification) ----------
// Email delivery will later be wired to SMTP/SendGrid. For now, console output + DB save (stub).
// Only the hashed token is stored; the plaintext is only sent — preventing reuse even if the DB leaks.

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique // SHA-256(plaintext token)
  expiresAt DateTime
  usedAt    DateTime?
  requestIp String?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  email     String // email-change verification uses the same table (currently only used at signup)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

/// Parent requests access to a student account; student must approve before data access.
model ParentChildLink {
  id           String           @id @default(uuid())
  parentUserId String
  childUserId  String
  status       ParentLinkStatus @default(PENDING)
  approvedAt   DateTime?
  rejectedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  parent User @relation("ParentChildLinksAsParent", fields: [parentUserId], references: [id], onDelete: Cascade)
  child  User @relation("ParentChildLinksAsChild", fields: [childUserId], references: [id], onDelete: Cascade)
  approvalTokens ParentLinkApprovalToken[]

  @@unique([parentUserId, childUserId])
  @@index([childUserId, status])
  @@index([parentUserId, status])
}

/// One-time token emailed to the student for parent-link approval.
model ParentLinkApprovalToken {
  id        String    @id @default(uuid())
  linkId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  link ParentChildLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, expiresAt])
}

/// Verifiable parent/guardian consent for minor students (KR PIPA / IN DPDP §9).
enum GuardianConsentMethod {
  KR_PASS
  KR_EMAIL_OTP
  IN_EMAIL_OTP
}

enum GuardianConsentStatus {
  PENDING
  VERIFIED
  EXPIRED
}

model GuardianConsentRequest {
  id              String                @id @default(uuid())
  studentUserId   String                @unique
  country         CountryCode
  method          GuardianConsentMethod
  status          GuardianConsentStatus @default(PENDING)
  parentName      String?
  parentEmail     String?
  /// KR — collected for PASS hand-off; not stored after verify when possible.
  parentPhone     String?
  policyVersion   String
  providerRef     String?
  verifiedAt      DateTime?
  requestIp       String?
  requestUa       String?
  verifyIp        String?
  verifyUa        String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  student User                   @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  tokens  GuardianConsentToken[]

  @@index([status, createdAt])
}

model GuardianConsentToken {
  id        String    @id @default(uuid())
  requestId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  request GuardianConsentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, expiresAt])
}

/// Admin-action audit log — who accessed / modified which user data, and when.
/// For trace in disputes / regulatory response. Also includes email-allowlist change history.
model AdminAccessLog {
  id         String   @id @default(uuid())
  adminEmail String // the email that passed the ADMIN_EMAILS allowlist at call time
  method     String // GET / POST / PATCH / DELETE
  path       String // /api/v1/admin/users/{id}
  query      String?  @db.Text // JSON.stringify(query)
  body       String?  @db.Text // JSON.stringify(body) — sensitive fields masked
  statusCode Int
  ip         String?
  userAgent  String?  @db.Text
  durationMs Int
  createdAt  DateTime @default(now())

  @@index([adminEmail, createdAt])
  @@index([path, createdAt])
}

/// Per-user security audit trail — every login outcome, password reset, device
/// switch, breach-block. Separate from AdminAccessLog because the user-facing
/// "where is my account logged in?" UX needs fast per-user lookups, and
/// AdminAccessLog is admin-only.
///
/// Known-user rows are deleted by UsersRepository.hardDelete so IP, user-agent,
/// device hash, and email metadata do not survive account deletion.
model SecurityEvent {
  id        String            @id @default(uuid())
  userId    String? // nullable — failed logins with unknown email have no user FK
  eventType SecurityEventType
  ip        String?
  userAgent String?           @db.Text
  metadata  Json? // { email?, deviceHash?, reason?, ... } — event-specific
  createdAt DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAIL
  LOGIN_LOCKED // 5-fail lockout triggered
  NEW_DEVICE_LOGIN // session displaced an earlier device
  DEVICE_REVOKE_OTHERS // user-initiated "log out other devices"
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_SUCCESS
  PASSWORD_CHANGE
  BREACH_PASSWORD_BLOCKED // pwnedpasswords rejected the chosen password
  ACCOUNT_DELETED
  PARENT_LINK_REQUESTED
  PARENT_LINK_APPROVED
  PARENT_LINK_REJECTED
  PARENT_LINK_REVOKED
}

/// Parent ↔ student link lifecycle. APPROVED required before parent can read child data.
enum ParentLinkStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

/// DEV-1 -- concurrent 1-device-per-account enforcement.
/// A row per (user, device) pair that has logged in. New device login flow:
///   1. Compute deviceHash on client (Capacitor Device.getId() + server salt)
///   2. POST /auth/login with X-Device-Hash header
///   3. Backend upserts AuthDevice, revokes every OTHER device's refresh jti
///      via Redis blacklist -> Netflix-style displacement, no confirm email
///      gate (account sharing -> ping-pong logout -> nobody can use it)
///
/// Rows are deleted on User cascade, on "logout other devices" self-service,
/// and on explicit revocation. We keep historical login record in
/// SecurityEvent (NEW_DEVICE_LOGIN); AuthDevice only tracks currently-bound
/// devices, not the history.
model AuthDevice {
  id           String   @id @default(uuid())
  userId       String
  /// SHA-256 of (client device fingerprint + server salt). 64 hex chars.
  deviceHash   String
  /// Friendly label for the Settings UI: "Pixel 7 · Chrome", "iPhone 15", etc.
  deviceName   String?
  /// IPv4 / IPv6 string captured on the most recent login from this device.
  lastIp       String?
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceHash])
  @@index([userId, lastSeenAt])
}

// ---------- CONCEPT LEARNING (concept lesson before problem solving) ----------
//
// A pre-learning module that operationalizes 6 cognitive-psychology principles as stages:
//   1. Bruner — Concrete → Pictorial → Abstract (CPA) representation transitions
//   2. Sweller — Cognitive Load Theory: worked example, low intrinsic-load entry
//   3. Marton — Variation Theory: vary one key dimension at a time
//   4. Ausubel — Advance Organizer (HOOK)
//   5. Karpicke — Retrieval Practice (self-check)
//   6. Misconception Cycle — exposing and correcting common misconceptions (conceptual change)
//
// One ConceptLesson = one NCERT chapter. Composed of a sequence of 5~8 ConceptStep entries.
// Before a user can enter problem-solving / mock exam for a unit, they must pass through the RETRIEVAL stage to unlock it.

model ConceptLesson {
  id                String     @id @default(uuid())
  /// NCERT class (India is first launch). The Korean grade is mapped secondarily via Unit.gradeLevels (through unitId).
  ncertClass        NcertClass
  /// NCERT chapter number (1~N within the class)
  chapterNumber     Int
  /// Stable identifier (e.g., C7-CH01-INTEGERS). Ensures identity across seed/migration.
  chapterCode       String     @unique
  titleKo           String // "정수"
  titleEn           String // "Integers"
  /// Hindi chapter title — first-launch language for India PoC. If missing, the service falls back to titleEn.
  titleHi           String? // "पूर्णांक"
  /// Big idea — the key insight the learner should take away from this lesson (1~2 sentences).
  bigIdeaKo         String     @db.Text
  bigIdeaEn         String     @db.Text
  bigIdeaHi         String?    @db.Text
  /// Expected study time (minutes). Default 15.
  estimatedMin      Int        @default(15)
  /// Study intensity 0~3 (cognitive-load estimate). 0=light, 3=killer chapter.
  cognitiveLoad     Int        @default(1)
  /// List of prerequisite chapterCodes (DAG dependency graph). Empty array = no prerequisites.
  prerequisiteCodes String[]   @default([])
  /// Mapping to Korean unit (optional). The bridge that connects to problem solving / wrong notes.
  unitId            String?
  subUnitId         String?
  /// Canonical Mastery 20-problem set — every user on this chapter sees the
  /// same Problem IDs in the same order. Curated once (on first practiceProblems
  /// call) from the pool with difficulty-balanced + concept-coverage rules,
  /// then frozen so cohort statistics, percentile, and per-concept weakness
  /// diagnostics are comparable across the entire user base. Re-curate is a
  /// one-shot admin tool (`scripts/recurate-mastery-set.ts`, future).
  masterySetProblemIds String[]  @default([])
  masterySetCuratedAt  DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  /// Optional FK into Curriculum metadata index (added 2026-05-24, Option C
  /// of the multi-country structure). Nullable so existing rows survive the
  /// migration with curriculumId=NULL; a backfill script then assigns the
  /// right Curriculum row per (countryCode='IN', grade=ncertClass, courseCode='NCERT').
  curriculumId   String?
  curriculum     Curriculum? @relation(fields: [curriculumId], references: [id])

  steps    ConceptStep[]
  unit     Unit?             @relation(fields: [unitId], references: [id])
  subUnit  SubUnit?          @relation(fields: [subUnitId], references: [id])
  progress ConceptProgress[]
  problems Problem[]
  drafts   ContentDraft[]
  /// Shadow inventory of curated problem sets (Mastery / Study / Diagnostic)
  /// per ConceptLesson. Phase 1 — backfilled from masterySetProblemIds;
  /// runtime still reads the array. See LessonProblemSet model below.
  lessonProblemSets LessonProblemSet[] @relation("ConceptLessonProblemSets")

  @@index([ncertClass, chapterNumber])
  @@index([unitId])
  @@index([curriculumId])
}

model ConceptStep {
  id             String          @id @default(uuid())
  lessonId       String
  /// 1-based. Step order.
  stepIndex      Int
  kind           ConceptStepKind
  titleKo        String
  titleEn        String
  titleHi        String? // India PoC. Falls back to titleEn if missing.
  /// Body content (Markdown + LaTeX allowed)
  bodyKo         String          @db.Text
  bodyEn         String          @db.Text
  bodyHi         String?         @db.Text
  /// Visual asset — for Pictorial/Concrete stages. URL or SVG data.
  visualType     String? // 'figure' | 'video' | 'manipulative' | 'graph' | 'svg'
  visualUrl      String?
  /// JSON parameters for dynamic graph rendering — used when visualType='graph'.
  ///   { type: 'unit-circle', angle: 120 }
  ///   { type: 'parabola', a: 1, b: 0, c: -3, range: [-3, 3] }
  ///   { type: 'number-line', marks: [-3, 0, 5], highlight: 5 }
  ///   { type: 'venn-2set', a: 18, b: 14, both: 6, labelA: 'Football', labelB: 'Basketball' }
  ///   { type: 'sine-wave', amplitude: 1, period: 360, marked: [{x: 30, y: 0.5}] }
  visualData     Json?
  /// MISCONCEPTION stage payload:
  ///   { wrong: "common wrong answer", why: "why it's confusing", correct: "correct thinking" }
  misconception  Json?
  /// WORKED_EXAMPLE stage payload:
  ///   [{ step: 1, math: "...", narration: "..." }, ...]
  workedSteps    Json?
  /// RETRIEVAL / GUIDED_PRACTICE stage payload:
  ///   { prompt: "...", accept: ["answer1", "answer2"], hint?: "...", explainKo?, explainEn? }
  retrievalCheck Json?
  /// REFLECT stage payload: { prompts: ["...", "..."] } — questions that elicit self-explanation / summary
  reflectPrompts Json?

  lesson ConceptLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, stepIndex])
  @@index([lessonId])
}

model ConceptProgress {
  id             String    @id @default(uuid())
  userId         String
  lessonId       String
  /// Current in-progress step index (1-based).
  currentStep    Int       @default(1)
  /// Array of completed step indices.
  completedSteps Int[]     @default([])
  /// When the user finished reading the concept walkthrough (not unlock signal).
  /// Filled by finalize-concept. Separate from masteredAt so the Study unlock
  /// gate isn't tripped by simply scrolling through the lesson.
  conceptWalkthroughAt DateTime?
  /// Study unlock signal — set ONLY when the user has answered the ANSWER step
  /// of every problem in the chapter's canonical Mastery 20-set correctly
  /// (retries allowed; user-spec 2026-05-23). Sticky once set.
  masteredAt     DateTime?
  /// Most recent RETRIEVAL score (0~100).
  retrievalScore Float?
  /// Cumulative study seconds.
  durationSec    Int       @default(0)
  startedAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user   User          @relation(fields: [userId], references: [id])
  lesson ConceptLesson @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
  @@index([userId, masteredAt])
}

// ---------- KOREAN CURRICULUM (2022 개정 교육과정) ----------
//
// Full fork of the concept-learning tree for country=KR users. Parallel to
// the NCERT-driven ConceptLesson tree (above). Why fork instead of mapping:
//   - Korean curriculum chapter boundaries do not line up 1:1 with NCERT
//     (e.g., one NCERT chapter splits across two Korean 단원).
//   - Korean problems / 수능 PYP differ in shape and pedagogy from NCERT
//     exercises — sharing the same Problem rows would be lossy.
//   - Korean curriculum revisions (2015 → 2022 → future) need to evolve
//     independently from India's NCERT track.
//
// One KoreanConceptLesson = one chapter (단원) inside one Korean subject
// (수학 1 / 공통수학1 / 대수 / 미적분Ⅰ ...). ConceptStep mirror lives in
// KoreanConceptStep. ConceptProgress will be extended in a later phase to
// accept either lesson type — for Phase 1 we just stand up the data shape.

/// Curriculum — top-level metadata index for "what country / grade / course
/// does this set of ConceptLessons belong to". Lets the app enumerate
/// 'available curricula' from a single table instead of branching across
/// NCERT (ConceptLesson) and Korean (KoreanConceptLesson) parallel tables.
///
/// One Curriculum row groups a body of chapters that share a country +
/// grade-band + course. Examples:
///   - { IN, CLASS_7,   "NCERT",            "Class 7 · Mathematics" }
///   - { IN, CLASS_11,  "NCERT",            "Class 11 · Mathematics" }
///   - { KR, MIDDLE_1,  "MIDDLE_MATH_1",    "중1 수학 1" }
///   - { KR, HIGH_1,    "HIGH_COMMON_1",    "고1 공통수학1" }
///   - { KR, HIGH_2,    "HIGH_ALGEBRA",     "고2 대수" }
///
/// Existing ConceptLesson + KoreanConceptLesson rows keep their primary
/// data shape; they just get a nullable curriculumId FK pointing here.
/// Backend country-aware branching (H1~H5 of 2026-05-24) keeps working
/// unchanged — Curriculum is a *metadata index* on top, not a replacement.
/// Future US/UK/AU rollouts add Curriculum rows + their own chapter pool
/// without forcing a single-table migration.
model Curriculum {
  id            String   @id @default(cuid())
  /// ISO country code mirroring User.country / CountryCode enum.
  countryCode   String
  /// Grade band — internal code. NCERT uses GradeLevel ("CLASS_7"~"CLASS_12"),
  /// Korea uses KoreanGrade ("MIDDLE_1"~"HIGH_3"). Stored as String here so
  /// the table doesn't bind to either enum.
  grade         String
  /// Course code inside this grade band. NCERT = "NCERT" (single course per
  /// class). Korea = KoreanSubject ("MIDDLE_MATH_1", "HIGH_COMMON_1", ...).
  courseCode    String
  /// Display name in the curriculum's primary language. "Class 7 · Mathematics"
  /// for IN, "중1 수학 1" / "고1 공통수학1" for KR.
  name          String
  /// Sort order inside the country's curriculum list.
  order         Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  conceptLessons       ConceptLesson[]
  koreanConceptLessons KoreanConceptLesson[]

  @@unique([countryCode, grade, courseCode])
  @@index([countryCode, order])
}

model KoreanConceptLesson {
  id                String        @id @default(uuid())
  koreanGrade       KoreanGrade
  koreanSubject     KoreanSubject
  /// Order inside its (grade, subject) bucket — 1..N.
  chapterNumber     Int
  /// Stable identifier, e.g. "K-G7-MATH1-CH02-INTEGERS".
  chapterCode       String        @unique
  titleKo           String // "정수와 유리수"
  /// English fallback for analytics / parents.
  titleEn           String?
  bigIdeaKo         String        @db.Text
  bigIdeaEn         String?       @db.Text
  estimatedMin      Int           @default(15)
  cognitiveLoad     Int           @default(1)
  /// Prerequisite chapterCodes — references other KoreanConceptLesson rows.
  prerequisiteCodes String[]      @default([])
  /// Canonical Mastery 20-problem set, mirroring the NCERT side. Curated once
  /// per Korean chapter from the Korean problem pool. Empty until Phase 3.
  masterySetProblemIds String[]   @default([])
  masterySetCuratedAt  DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  /// Optional FK into Curriculum (same as NCERT side). Backfilled by the
  /// migration script to (countryCode='KR', grade=koreanGrade, courseCode=koreanSubject).
  curriculumId   String?
  curriculum     Curriculum? @relation(fields: [curriculumId], references: [id])

  steps    KoreanConceptStep[]
  problems Problem[]            @relation("KoreanLessonProblems")
  progress KoreanConceptProgress[]
  /// Shadow inventory of curated problem sets per KoreanConceptLesson —
  /// parallel to the IN side. See LessonProblemSet model below.
  lessonProblemSets LessonProblemSet[] @relation("KoreanConceptLessonProblemSets")

  @@unique([koreanGrade, koreanSubject, chapterNumber])
  @@index([koreanGrade, koreanSubject])
  @@index([curriculumId])
}

/// Kind of curated set hanging off a lesson. Phase 1 ships MASTERY_3STEP
/// (the canonical 20-problem mastery sequence). STUDY_1STEP (Practice tab
/// single-step pool) and DIAGNOSTIC (onboarding warm-up) are reserved for
/// later phases — backfill skips them, the schema is forward-compatible.
enum SetType {
  MASTERY_3STEP
  STUDY_1STEP
  DIAGNOSTIC
}

/// Lifecycle of a curated set. Backfill maps existing masterySetProblemIds
/// to READY when the array length is 20 and every Problem passes quality
/// filters (not EXCLUDED / not mismatched). Anything else lands in
/// NEEDS_REVIEW so admin readiness dashboards surface the gap explicitly.
enum SetStatus {
  DRAFT
  READY
  NEEDS_REVIEW
  RETIRED
}

/// Shadow inventory of curated problem sets — Phase 1 of the LessonProblemSet
/// expand-contract migration. Runtime still reads
/// ConceptLesson.masterySetProblemIds / KoreanConceptLesson.masterySetProblemIds;
/// this table is populated by backfill so admin readiness endpoints can
/// surface IN/KR set completeness on the same contract. Dual-write and
/// dual-read are explicitly deferred (post-launch) to keep the student path
/// untouched. Polymorphism modelled by two nullable FKs + a CHECK constraint
/// (added via raw SQL in the migration: exactly one of the two must be set)
/// — Prisma cannot express CHECK in schema.prisma directly.
model LessonProblemSet {
  id                      String      @id @default(cuid())
  country                 CountryCode
  setType                 SetType
  /// IN side — exactly one of (conceptLessonId, koreanConceptLessonId) is set.
  conceptLessonId         String?
  conceptLesson           ConceptLesson?       @relation("ConceptLessonProblemSets", fields: [conceptLessonId], references: [id], onDelete: Cascade)
  /// KR side — mirror of above.
  koreanConceptLessonId   String?
  koreanConceptLesson     KoreanConceptLesson? @relation("KoreanConceptLessonProblemSets", fields: [koreanConceptLessonId], references: [id], onDelete: Cascade)
  /// Denormalised chapter identifier — admin tools join on this without
  /// having to resolve the polymorphic side first.
  chapterCode             String
  /// Ordered list of Problem.id. Length is part of the readiness contract
  /// (Phase 1 expects exactly 20 for MASTERY_3STEP).
  problemIds              String[]    @default([])
  status                  SetStatus   @default(DRAFT)
  /// Bumped every time admin freezes/swaps the set. v1 = backfill output.
  version                 Int         @default(1)
  curatedAt               DateTime?
  retiredAt               DateTime?
  /// Admin user who froze this version (nullable so backfill rows have no
  /// owner — they were not curated by a person).
  curatedByUserId         String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  /// One active version per (country, chapter, type). Retired versions keep
  /// their distinct version number, so this composite tolerates them.
  @@unique([country, chapterCode, setType, version])
  @@index([country, status, setType])
  @@index([conceptLessonId])
  @@index([koreanConceptLessonId])
}

/// KR-side per-user chapter progress. Parallel to ConceptProgress (NCERT).
/// Stores Mastery → Study unlock signal for Korean chapters: masteredAt is
/// stamped (sticky) once the user has submitted an ANSWER-step attempt on
/// every problem in KoreanConceptLesson.masterySetProblemIds (matches the
/// "다 풀면 완주" gate from attempts.service.checkAndUnlockMastery).
///
/// Mirrors NCERT shape only for the fields KR currently uses. Other NCERT
/// progress columns (conceptWalkthroughAt, currentStep, completedSteps,
/// retrievalScore, durationSec) are intentionally omitted until KR side
/// needs them — Phase 4 progress aggregation can add them then.
model KoreanConceptProgress {
  id              String    @id @default(uuid())
  userId          String
  lessonId        String
  /// Study unlock signal — sticky once set. attempts.service.checkAndUnlockMastery
  /// branches on Problem.koreanConceptLessonId; when KR all-attempted, stamps this.
  masteredAt      DateTime?
  startedAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user   User                @relation(fields: [userId], references: [id])
  lesson KoreanConceptLesson @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
  @@index([userId])
}

model KoreanConceptStep {
  id             String          @id @default(uuid())
  lessonId       String
  stepIndex      Int
  kind           ConceptStepKind
  titleKo        String
  bodyKo         String          @db.Text
  visualType     String?
  visualUrl      String?
  visualData     Json?
  misconception  Json?
  workedSteps    Json?
  retrievalCheck Json?
  reflectPrompts Json?

  lesson KoreanConceptLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, stepIndex])
  @@index([lessonId])
}

// ---------- WEEKLY REPORT ----------

model WeeklyReport {
  id             String    @id @default(uuid())
  userId         String
  isoWeek        String // "2024-W45"
  weekStart      DateTime  @db.Date
  weekEnd        DateTime? @db.Date // the spec's weekEndDate
  totalHours     Float
  problemsSolved Int
  accuracyPct    Float
  aiScore        Float // 0~10
  mentorMessage  String    @db.Text
  generatedAt    DateTime  @default(now())

  // ---- Additional spec fields (separate summaries for student / parent / teacher) ----
  tenantId                String?
  studentSummary          String?  @db.Text
  parentSummary           String?  @db.Text
  teacherSummary          String?  @db.Text
  topImprovedConcepts     String[] @default([]) // list of conceptId
  weakConcepts            String[] @default([]) // list of conceptId
  repeatedErrorPatterns   String[] @default([]) // list of ErrorPatternProfile ids
  totalSessions           Int      @default(0)
  totalAttempts           Int      @default(0)
  averageStudyDurationSec Int      @default(0)
  recommendedNextGoals    String[] @default([]) // next week's goals (1~3 free-form strings)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, isoWeek])
  @@index([tenantId, weekStart])
}

// =============================================================
//  AI Prescription System — new models (Phase 1.1)
// =============================================================

/// Academy / institution. The base unit of multi-tenant. For solo students, tenantId=null.
model Tenant {
  id           String   @id @default(uuid())
  name         String // "Mathēma Academy"
  /// Short code for URL / login (e.g., "mathema", "demo-academy").
  code         String   @unique
  /// Operator contact (optional).
  contactEmail String?
  /// 'active' | 'suspended' — tenant-level deactivation.
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users User[]
}

/// Concept — the heart of the recommendation engine.
/// A finer-grained unit than Unit (e.g., Unit "Calculus II" → Concept "Chain Rule").
/// One Concept can be mapped to multiple Unit/SubUnit entries, so the N:M is handled via problemConcepts.
model Concept {
  id         String      @id @default(uuid())
  /// Stable identifier — e.g., "chain_rule", "composite_function". Ensures seed/import consistency.
  code       String      @unique
  name       String // "Chain Rule"
  /// Korean localised name — sourced from NCERT_CHAPTERS.titleKo via ConceptsBootstrap.
  /// Nullable so existing rows back-fill on the next sync; consumers fall back to `name`.
  nameKo     String?
  /// Subject — 'math', 'physics', etc. First PoC is 'math' only.
  subject    String      @default("math")
  /// Grade level — used to filter Concept recommendations to the student's grade.
  gradeLevel GradeLevel?

  /// Parent Concept (e.g., 'chain_rule' → parent='differentiation'). Parent in the tree structure.
  parentConceptId String?
  parent          Concept?  @relation("ConceptParent", fields: [parentConceptId], references: [id])
  children        Concept[] @relation("ConceptParent")

  /// Array of prerequisite Concept IDs (DAG). chain_rule's prerequisites = [composite_function, derivative].
  /// If the student can't solve chain_rule → the recommendation engine diagnoses prerequisites first.
  prerequisiteConceptIds String[] @default([])
  /// Related Concept IDs (weakly bidirectional). Used to diversify recommendations.
  relatedConceptIds      String[] @default([])

  /// Bridge to the Korean Unit (for compatibility during gradual migration).
  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  problems            ProblemConcept[]
  masteryTrajectories MasteryTrajectory[]
  masteryEvents       MasteryEvent[]
  errorPatterns       ErrorPatternProfile[]

  @@index([subject, gradeLevel])
  @@index([parentConceptId])
}

/// Problem ↔ Concept many-to-many + weight (how strongly this problem measures this concept, 0~1).
model ProblemConcept {
  problemId String
  conceptId String
  /// 0~1. 1 = problem directly tests this concept. 0.3 = concept is only incidentally needed.
  weight    Float  @default(1.0)

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([problemId, conceptId])
  @@index([conceptId])
}

/// Current snapshot + trend of per-concept mastery (the spec's MasteryTrajectory).
/// MasteryEvent is the time-series history; MasteryTrajectory is the resulting current value.
/// The existing MasterySnapshot remains unit-scoped (for compatibility). The new MasteryTrajectory is concept-scoped.
model MasteryTrajectory {
  id        String  @id @default(uuid())
  userId    String
  conceptId String
  tenantId  String?

  /// 0~100. Not accuracy alone — combines response time, hints, confidence, recency, repeated errors.
  masteryScore       Float        @default(0)
  /// Confidence interval in the form mean±SE (optional). Wider when evidenceCount is small.
  confidenceInterval Float?
  trend              MasteryTrend @default(STABLE)

  /// Cumulative attempt count — gates score reliability.
  evidenceCount          Int   @default(0)
  /// Accuracy over the most recent N attempts (0~1).
  recentAccuracy         Float @default(0)
  averageResponseTimeSec Int   @default(0)
  hintUsageRate          Float @default(0)
  /// Difference between self-confidence (selfConfidenceScore) and actual accuracy — diagnoses overconfidence.
  confidenceGap          Float @default(0)

  lastAttemptAt DateTime?
  /// 'rule_based' | 'llm' | 'hybrid' | 'teacher_override' — who performed the update.
  updatedBy     MasteryUpdateSource @default(RULE_BASED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([userId, conceptId])
  @@index([tenantId, masteryScore])
  @@index([userId, lastAttemptAt])
}

/// Time-series history of MasteryTrajectory — for heatmaps / graphs.
/// One row is created at the end of each Attempt. Tracks how masteryScore changes over time.
model MasteryEvent {
  id            String   @id @default(uuid())
  userId        String
  conceptId     String
  tenantId      String?
  attemptId     String?
  /// Post-update score (0~100).
  masteryScore  Float
  /// Score change caused by this attempt (+5, -6, etc.).
  delta         Float
  evidenceCount Int
  createdAt     DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@index([userId, conceptId, createdAt])
}

/// Cumulative statistics and status of recurring-mistake patterns.
/// Surfaced in student UI as: "Recurring mistake patterns" / "Study-habit signals" / "Per-concept sticking points".
model ErrorPatternProfile {
  id        String    @id @default(uuid())
  userId    String
  conceptId String
  tenantId  String?
  errorCode ErrorCode

  /// Cumulative occurrence count.
  frequency       Int    @default(0)
  /// Occurrence count within the most recent N(=5) attempts.
  recentFrequency Int    @default(0)
  severity        String @default("low") // 'low' | 'medium' | 'high'

  firstDetectedAt DateTime @default(now())
  lastDetectedAt  DateTime @default(now())

  /// 1~2-sentence insight written by the LLM (the spec's llmSummary).
  llmSummary         String?  @db.Text
  /// List of supporting Attempt.id values (up to ~20).
  evidenceAttemptIds String[] @default([])

  status ErrorPatternStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([userId, conceptId, errorCode])
  @@index([tenantId, status])
  @@index([userId, status])
}

/// Versioned log of LLM analysis output.
/// Stores rawOutput / parsedOutput / promptVersion / inputHash all together →
/// allows regression analysis of prompt v3 vs. v4 judgment differences later.
model LLMAnalysisLog {
  id        String  @id @default(uuid())
  userId    String
  attemptId String
  problemId String
  tenantId  String?

  modelName     String // 'claude-opus-4-5' | 'gpt-4o'
  promptVersion String // 'attempt-analyze@v1'
  /// SHA-256 of canonical input — avoids duplicate calls / enables caching for the same input.
  inputHash     String

  rawOutput    Json
  /// rawOutput normalized to our schema.
  /// { errorCodes: ErrorCode[], conceptWeakness: string[],
  ///   reasoningSummary: string, recommendedAction: string }
  parsedOutput Json

  confidenceScore  Float // LLM self-reported 0~1
  validationStatus LLMValidationStatus @default(PENDING)

  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([attemptId])
  @@index([promptVersion, modelName])
}

/// DB tracking for BullMQ LLM analysis jobs — persistent record separate from queue state.
///   1 LLMAnalysisJob ↔ 0..1 LLMAnalysisLog (Log is created only on success)
///   When retryCount > maxRetries, FAILED is retained for reprocessing only
///   while the account exists.
/// UsersRepository.hardDelete removes them by userId.
model LLMAnalysisJob {
  id             String       @id @default(uuid())
  attemptId      String       @unique           // 1:1 — prevents duplicate enqueue of the same attempt.
  userId         String
  problemId      String
  tenantId       String?
  status         LLMJobStatus @default(PENDING)
  retryCount     Int          @default(0)
  maxRetries     Int          @default(3)
  /// BullMQ job id (result of queue.add). Used to query queue state.
  bullJobId      String?
  /// Last failure reason (truncated).
  lastError      String?      @db.Text
  /// Last worker-start time — used to detect stale jobs.
  startedAt      DateTime?
  /// Last state-change time.
  lastChangedAt  DateTime     @default(now())
  /// LLMAnalysisLog id created on success.
  resultLogId    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, lastChangedAt])
  @@index([userId, status])
  @@index([tenantId, status])
}

/// Tracks whether an AI recommendation actually had an effect.
/// Whether an attempt started from a recommendation — observed via accepted/solved/result.
model RecommendationLog {
  id        String  @id @default(uuid())
  userId    String
  sessionId String?
  tenantId  String?

  recommendedProblemId String
  recommendationType   RecommendationType
  /// One-line rationale shown to student / teacher / parent (the spec's reason).
  reason               String             @db.Text

  /// Concept / error code / expected difficulty the recommendation targets.
  targetConceptId    String?
  targetErrorCode    ErrorCode?
  expectedDifficulty Int        @default(3)

  accepted Boolean               @default(false)
  solved   Boolean               @default(false)
  result   RecommendationResult?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendedProblem Problem @relation("RecommendedProblem", fields: [recommendedProblemId], references: [id])

  @@index([userId, createdAt])
  @@index([tenantId, createdAt])
  @@index([userId, accepted, solved])
}

/// History of teacher overrides of AI judgments.
/// Records corrections like "this student does not lack the concept — they keep making sign mistakes during solving".
model TeacherOverride {
  id        String  @id @default(uuid())
  /// Teacher's User.id.
  teacherId String
  /// Target student's User.id.
  userId    String
  tenantId  String?

  targetType TeacherOverrideTargetType
  /// Row id being modified (MasteryTrajectory.id / ErrorPatternProfile.id / RecommendationLog.id).
  targetId   String

  beforeValue Json
  afterValue  Json
  reason      String @db.Text

  createdAt DateTime @default(now())

  teacher User @relation("TeacherOverrider", fields: [teacherId], references: [id], onDelete: Cascade)
  user    User @relation("StudentTarget", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([teacherId, createdAt])
  @@index([tenantId, createdAt])
}

/// Ratings of AI output (student / teacher / parent / admin).
/// Meaning differences are preserved by raterType.
model Feedback {
  id         String             @id @default(uuid())
  targetType FeedbackTargetType
  /// Target row id (LLMAnalysisLog / WeeklyReport / RecommendationLog / Problem.explanation, etc.).
  targetId   String

  raterType FeedbackRaterType
  /// Rater's User.id (admin/teacher/parent are assumed to have separate accounts; for students it's their own user.id).
  raterId   String

  aiInsightRating Int // 1~5
  comment         String? @db.Text

  createdAt DateTime @default(now())

  rater User @relation(fields: [raterId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([raterId, createdAt])
}

// ============================================================
//  CONTENT INGESTION — PDF / API / JSON → auto-extract → LLM draft → human review → publish as Problem
//  Source-agnostic design: the SourceAdapter interface normalizes all sources into the same flow.
//    PDF (NCERT, EBS) → text-extract → exercise-index → problem-extract → drafts
//    HTTP_API (EBS API, public question banks) → fetch → normalize → drafts
//    JSON_BULK / CSV (manually entered) → parse → drafts
// ============================================================

enum ContentSourceType {
  PDF // file upload
  HTTP_API // external REST API (EBS / public source)
  JSON_BULK // pre-normalized array of problems
  CSV // tabular format
}

enum ContentIngestStatus {
  QUEUED // just uploaded / job registered
  FETCHING // fetching from external source (API) — skipped for PDF
  EXTRACTING // extracting text / payload
  INDEXING // indexing class / chapter boundaries
  DRAFTING // generating 3-step MC drafts via LLM
  READY // drafts populated in ContentDraft, awaiting review
  FAILED // processing failed
}

enum ContentDraftStatus {
  PENDING // just generated by LLM
  IN_REVIEW // someone has opened it and is working on it
  APPROVED // reviewer approved — next step is publish
  REJECTED // discarded
  PUBLISHED // published as a Problem
}

/// One unit of content-ingestion work. Same model for both PDF upload and EBS API pull.
/// Which source it is gets branched on sourceType; source-specific settings live in sourceConfigJson.
model ContentIngestJob {
  id           String              @id @default(uuid())
  uploadedById String
  uploadedBy   User                @relation("UploadedIngestJobs", fields: [uploadedById], references: [id])

  /// What is being fetched
  sourceType   ContentSourceType
  /// Free-form per-adapter configuration — e.g.:
  ///   PDF:      { fileName, fileSize, sha256, filePath }
  ///   HTTP_API: { url, authRef, query, pagination, headersRef }
  ///   JSON_BULK:{ filePath } / CSV: { filePath, delimiter }
  sourceConfigJson Json

  /// Prevents re-running the same source — PDF=sha256, API=hash of url+query, etc. Filled by the adapter.
  sourceDigest String  @unique
  /// UI label (e.g., "NCERT_Math_Class_7_to_12.pdf" or "EBS API · Suneung Special · 2026").
  label        String

  status          ContentIngestStatus @default(QUEUED)
  /// Classes detected during processing (kept in their native notation — "CLASS_8", "CLASS_11", etc.).
  detectedClasses String[]            @default([])

  /// Progress metrics (each adapter populates as appropriate).
  totalItems         Int? // PDF=page count, API=total records
  extractedExercises Int?
  extractedProblems  Int?
  draftsCreated      Int?

  errorMessage String? @db.Text
  /// Intermediate index produced by the adapter (for replay / debugging).
  indexJson    Json?

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  drafts ContentDraft[]

  @@index([uploadedById, createdAt])
  @@index([status, createdAt])
  @@index([sourceType, createdAt])
}

/// 3-step MC problem draft generated by the LLM. Review → approve → publish as a Problem.
model ContentDraft {
  id          String             @id @default(uuid())
  ingestJobId String?
  ingestJob   ContentIngestJob?  @relation(fields: [ingestJobId], references: [id], onDelete: SetNull)

  /// Mapped ConceptLesson (auto-populated via class/chapter matching). If NULL, a human must map it manually.
  conceptLessonId String?
  conceptLesson   ConceptLesson? @relation(fields: [conceptLessonId], references: [id], onDelete: SetNull)

  /// Source label — for debugging / UI display. e.g., "NCERT · CLASS_8 · Ch5 · Ex5.1 · Q1"
  sourceLabel    String
  /// Extracted NCERT original text (also used as LLM input).
  originalText   String  @db.Text
  /// Extracted page number (the raw text of that page can be retrieved from it).
  sourcePage     Int?

  /// Raw response (JSON) generated by the LLM — entire 3-step + choices + rationale.
  aiModel        String?
  aiPromptVer    String?
  aiResponseJson Json?
  aiTokensIn     Int?
  aiTokensOut   Int?
  aiCostUsd      Decimal? @db.Decimal(10, 6)

  /// Reviewer-edited version — the human-edited final. If NULL, aiResponseJson is used.
  editedJson     Json?

  /// Proposed difficulty (based on LLM analysis).
  proposedDifficulty      Difficulty @default(MIDDLE)
  proposedDifficultyLevel Int        @default(3)

  status         ContentDraftStatus @default(PENDING)
  /// Reviewer
  reviewedById   String?
  reviewedBy     User?  @relation("ReviewedDrafts", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  reviewerNote   String? @db.Text

  /// On approval → publish: the resulting Problem id (back-reference).
  publishedProblemId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([ingestJobId, status])
  @@index([conceptLessonId, status])
}

// ---------- BILLING (Google Play subscriptions) ----------

enum SubscriptionStatus {
  ACTIVE      /// valid + within paid period
  GRACE       /// payment failed but Google grace period — still entitled
  ON_HOLD     /// payment failed past grace — not entitled, can recover
  PAUSED      /// user paused (rare)
  CANCELED    /// canceled by user, still within expiry
  EXPIRED     /// expired, no longer entitled
}

/// Durable Pub/Sub RTDN inbox — PROCESSED only after successful dispatch.
enum RtdnInboxStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  RETRYABLE
  ORPHAN
  DEAD
}

/// One row per user that has ever subscribed. We update in place when the
/// status changes (RTDN notifications + verify-on-purchase). Token uniqueness
/// is enforced by Google; we keep it unique so dupe webhooks no-op.
model Subscription {
  id                   String              @id @default(cuid())
  userId               String              @unique
  productId            String              // 'premium_monthly' | 'premium_yearly'
  purchaseToken        String              @unique
  orderId              String?             // Google Play latestOrderId (refund-trace)
  linkedPurchaseToken  String?             // prior token after upgrade/downgrade (Play API)
  acknowledgedAt       DateTime?           // server (or client fallback) ack timestamp
  acknowledgementState String?             // PENDING | ACKNOWLEDGED | FAILED
  status               SubscriptionStatus
  startTime            DateTime
  expiryTime           DateTime
  autoRenewing         Boolean             @default(true)
  cancelReason         Int?                // Google docs: 0=user, 1=system, 2=replaced, 3=developer
  isInIntroOfferPeriod Boolean             @default(false)  // 60-day Launch Promo trace
  countryCode          String?
  priceAmountMicros    String?             // 1_000_000 micros = 1 currency unit
  currencyCode         String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  events               SubscriptionEvent[]
  purchaseTokens       SubscriptionPurchaseToken[]

  @@index([status])
  @@index([expiryTime])
  @@index([orderId])
}

/// Purchase-token history for upgrade/downgrade — maps superseded tokens to
/// the current Subscription row so RTDN / voided events on old tokens resolve.
model SubscriptionPurchaseToken {
  id              String       @id @default(cuid())
  subscriptionId  String
  purchaseToken   String       @unique
  productId       String
  linkedFromToken String?
  supersededAt    DateTime?
  createdAt       DateTime     @default(now())

  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([linkedFromToken])
}

/// Durable Google Play RTDN inbox (Pub/Sub messageId is unique).
/// Transient failures stay RETRYABLE and return 5xx so Pub/Sub retries.
model RtdnInbox {
  id               String           @id @default(cuid())
  messageId        String           @unique
  status           RtdnInboxStatus  @default(RECEIVED)
  attempts         Int              @default(0)
  payloadHash      String
  payload          Json
  notificationKind String?
  purchaseToken    String?
  lastError        String?
  leaseUntil       DateTime?
  receivedAt       DateTime         @default(now())
  processedAt      DateTime?
  updatedAt        DateTime         @updatedAt

  @@index([status, receivedAt])
  @@index([purchaseToken])
  @@index([status, leaseUntil])
}

/// Audit log of every subscription state-change signal we receive
/// (RTDN messages + manual admin actions + verify-on-purchase results).
model SubscriptionEvent {
  id             String       @id @default(cuid())
  subscriptionId String
  eventType      String       // RTDN notificationType or 'verify' / 'admin.cancel' / etc.
  payload        Json
  receivedAt     DateTime     @default(now())

  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, receivedAt])
  @@index([eventType])
}

/// System-level key/value store for bootstrap state we don't want to rebuild
/// from scratch on every container start. The first user is
/// ConceptLessonsBootstrap, which stores a stable hash of the seed content
/// here so a deploy that genuinely changes a narration / fade flag / visual
/// payload auto-triggers a full re-sync, while a deploy that only touched
/// unrelated code skips the 1100+ query rebuild. Keep the surface narrow —
/// this table is for internal sync state, not user-visible config.
model SystemMetadata {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
