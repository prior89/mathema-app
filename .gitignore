# Node
node_modules/
**/node_modules/
**/dist/
**/coverage/
*.log

# Env
.env
.env.local
**/.env
**/.env.local
# Vite mode-specific envs (production / staging) — may carry per-target
# API URLs or analytics keys; never commit. CI injects them at build time.
**/.env.production
**/.env.staging
# Android signing (keystore + passwords — never commit)
.keystore.env
*.jks
*.keystore
# Signed AAB artifacts — built locally for Play upload, never source-controlled
release/
# Local accumulated release build outputs (run-*/aab-unpacked etc from prior Play
# candidate builds). Distinct from the final signed "release/" artifacts above.
# These are large (tens of MB) and should never be source-controlled.
dist-releases/
# OS / Editor
.DS_Store
.vscode/
.idea/
*.iml
# App — Vite / Playwright / Capacitor build
app/dist/
app/test-results/
# Repo-root playwright/e2e output (responsive snapshot runs etc.) — never source-controlled
test-results/
app/playwright-report/
app/curr.json
app/android/.gradle/
app/android/build/
app/android/app/build/
app/android/captures/
app/android/local.properties
app/android/.idea/
# Server — Nest build + uploaded files + Prisma generated
server/dist/
/server/uploads/
server/scripts/ncert-import/pages/
server/scripts/ncert-import/problems.json
server/scripts/ncert-import/exercise-index.json
# Raw NCERT textbook extracts — copyrighted, never commit.
# If already committed, run from the repo root to scrub:
#   git rm -r --cached scripts/ncert-pdf-extract/output server/scripts/ncert-import
#   git commit -m "remove raw NCERT extracts (copyright)"
scripts/ncert-pdf-extract/output/
scripts/ncert-pdf-extract/output_test/
scripts/ncert-pdf-extract/.cache/
# Throwaway diagnostic / one-off scripts written into the server/ root
# (e.g. _diag.js, _swap-env-to-prod.js, _translate-math.js)
server/_*.js
server/.env.local-backup
# Docker volumes
pgdata/
__pycache__/
*.pyc
# Python virtualenvs (per-service isolation, never committed)
**/.venv/

