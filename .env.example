# =============================================================
#  Mathēma — unified environment variables.
#  Copy to .env at the repo root and fill in any required values:
#
#    cp .env.example .env
#
#  Both workspaces read this file: the server (via dotenv) and
#  the Vite app (only VITE_* prefixed variables are exposed to
#  the browser bundle).
# =============================================================

# ----- Server (NestJS) -----
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:5173

# postgres (provided by docker compose — leave as-is for local dev)
DATABASE_URL=postgresql://mathema:mathema@localhost:5432/mathema?schema=public

# redis (provided by docker compose)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT — generate a new secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=dev-access-secret-CHANGE-ME-min-32-chars-xxxxxxxxxxxx
JWT_REFRESH_SECRET=dev-refresh-secret-CHANGE-ME-min-32-chars-yyyyyyyy
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d

# Admin allowlist (comma-separated)
ADMIN_EMAILS=polopot123@gmail.com

# AI / LLM — Anthropic or OpenAI
AI_LLM_PROVIDER=anthropic
AI_LLM_API_KEY=
AI_LLM_MODEL=claude-opus-4-7

# Mail (optional) — when unset, password-reset tokens are logged as "[MAIL stub] ..."
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=noreply@mathema.ai

# ----- App (Vite) — only VITE_* variables reach the client bundle -----
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Demo auto-login (dev / internal demos only — must be false in production)
VITE_ENABLE_DEMO_AUTO_LOGIN=true
VITE_DEMO_EMAIL=polopot123@gmail.com
VITE_DEMO_PASSWORD=password1234

# Optional: Google Sign-In (when unset, the Google button is hidden)
VITE_GOOGLE_CLIENT_ID=

# Optional: Sentry (when unset, the SDK is a no-op)
VITE_SENTRY_DSN=
