\end{figure}

\begin{figure}
\includegraphics[alt={},max width=\textwidth]{https://cdn.mathpix.com/cropped/19e1e2c4-cfa6-4b0f-a938-00cd45c6f750-210.jpg?height=576&width=519&top_left_y=400&top_left_x=166}
