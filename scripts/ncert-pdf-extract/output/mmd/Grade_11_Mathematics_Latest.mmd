m & =\tan \theta \\
& =\tan \left(180^{\circ}-\angle \mathrm{MPQ}\right)=-\tan \angle \mathrm{MPQ} \\
& =-\frac{\mathrm{MQ}}{\mathrm{MP}}=-\frac{y_{2}-y_{1}}{x_{1}-x_{2}}=\frac{y_{2}-y_{1}}{x_{2}-x_{1}}
