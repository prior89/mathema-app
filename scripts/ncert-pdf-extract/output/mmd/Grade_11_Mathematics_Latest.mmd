\includegraphics[alt={},max width=\textwidth]{https://cdn.mathpix.com/cropped/19e1e2c4-cfa6-4b0f-a938-00cd45c6f750-242.jpg?height=433&width=563&top_left_y=402&top_left_x=909}
\captionsetup{labelformat=empty}
\caption{Fig 11.1}
\end{figure}
