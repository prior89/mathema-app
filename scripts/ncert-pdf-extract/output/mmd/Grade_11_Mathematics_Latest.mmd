\end{figure}

For batsman B

\begin{figure}
\includegraphics[alt={},max width=\textwidth]{https://cdn.mathpix.com/cropped/19e1e2c4-cfa6-4b0f-a938-00cd45c6f750-291.jpg?height=112&width=1168&top_left_y=1523&top_left_x=224}
