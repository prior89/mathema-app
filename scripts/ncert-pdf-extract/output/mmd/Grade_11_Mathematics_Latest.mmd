\hline \(\cos\) & decreases from 1 to 0 & decreases from 0 to - 1 & increases from -1 to 0 & increases from 0 to 1 \\
\hline \(\tan\) & increases from 0 to \(\infty\) & increases from - oto 0 & increases from 0 to \(\infty\) & increases from - \(\infty\) to 0 \\
\hline cot & decreases from \(\infty\) to 0 & decreases from 0 to- \(\infty\) & decreases from \(\infty\) to 0 & decreases from 0to \(-\infty\) \\
\hline sec & increases from 1 to \(\infty\) & increases from ---0to-1 & decreases from -1to--- & decreases from \(\infty\) to 1 \\
\hline cosec & decreases from \(\infty\) to 1 & increases from 1 to \(\infty\) & increases from --oto-1 & decreases from -1 to \(-\infty\) \\
\hline
\end{tabular}

