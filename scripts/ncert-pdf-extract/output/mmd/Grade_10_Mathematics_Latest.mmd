\includegraphics[alt={},max width=\textwidth]{https://cdn.mathpix.com/cropped/0f6def98-c5f4-41d3-8cce-ab69b5f89494-019.jpg?height=242&width=471&top_left_y=1174&top_left_x=990}
\captionsetup{labelformat=empty}
\caption{Fig. A1.1}
