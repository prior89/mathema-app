\[\operatorname{ar}(\mathrm{BDE})=\frac{1}{2} \mathrm{DB} \times \mathrm{EN},\]
\[\operatorname{ar}(\mathrm{ADE})=\frac{1}{2} \mathrm{AE} \times \mathrm{DM} \text { and } \operatorname{ar}(\mathrm{DEC})=\frac{1}{2} \mathrm{EC} \times \mathrm{DM} .\]

