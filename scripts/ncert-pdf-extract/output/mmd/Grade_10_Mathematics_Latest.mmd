\includegraphics[alt={},max width=\textwidth]{https://cdn.mathpix.com/cropped/0f6def98-c5f4-41d3-8cce-ab69b5f89494-120.jpg?height=1017&width=719&top_left_y=729&top_left_x=757}
\captionsetup{labelformat=empty}
\caption{Fig. 6.1}
\end{figure}
