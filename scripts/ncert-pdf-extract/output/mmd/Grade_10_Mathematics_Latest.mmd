\captionsetup{labelformat=empty}
\caption{Table 13.15}
\begin{tabular}{|l|l|l|}
\hline Marks & Number of students ( f ) & Cumulative frequency (cf) \\
\hline 0-10 & 5 & 5 \\
\hline 10-20 & 3 & 8 \\
\hline 20-30 & 4 & 12 \\
\hline 30-40 & 3 & 15 \\
\hline 40-50 & 3 & 18 \\
\hline 50-60 & 4 & 22 \\
\hline 60-70 & 7 & 29 \\
