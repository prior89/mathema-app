& \boldsymbol{d}=\left|\frac{\left(\overrightarrow{\mathrm{b}}_{1} \times \overrightarrow{\mathrm{b}}_{2}\right) \cdot\left(\vec{a}_{2} \times \vec{a}_{1}\right)}{\left|\vec{b}_{1} \times \vec{b}_{2}\right|}\right|
\end{aligned}\]

