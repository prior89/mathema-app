\begin{figure}
\includegraphics[alt={},max width=\textwidth]{https://cdn.mathpix.com/cropped/f750de5f-2c52-4290-b4df-5a275c636b7e-404.jpg?height=653&width=479&top_left_y=263&top_left_x=485}
