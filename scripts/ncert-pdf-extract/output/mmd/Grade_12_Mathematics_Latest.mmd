\[\begin{aligned}
\frac{\mathrm{BC}}{\mathrm{AB}} & =\cos \mathrm{B} \\
\mathrm{BC} & =\mathrm{AB} \cos \mathrm{~B} \\
a & =c \cos \mathrm{~B} \\
