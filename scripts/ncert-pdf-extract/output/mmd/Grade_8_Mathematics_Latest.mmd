\hline 1 & \(1 \times 1=1=1^{2}\) \\
\hline 2 & \(2 \times 2=4=2^{2}\) \\
\hline 3 & \(3 \times 3=9=3^{2}\) \\
\hline 5 & \(5 \times 5=25=5^{2}\) \\
\hline 8 & \(8 \times 8=64=8^{2}\) \\
\hline a & \(a \times a=a^{2}\) \\
\hline
