\caption{Fig. 5.13A}
\end{figure}

\begin{figure}
\includegraphics[alt={},max width=\textwidth]{https://cdn.mathpix.com/cropped/4cec7484-b4be-4c71-abd9-c86b8e70e6e7-122.jpg?height=286&width=253&top_left_y=756&top_left_x=721}
